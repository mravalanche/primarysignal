# Copy to .env.publication.seed. These distinct logins reach the same _test database.
PRIMARY_SIGNAL_TEST_DATABASE_URL=postgresql+psycopg://migration_test:REPLACE_ME@database:5432/primary_signal_publication_test # pragma: allowlist secret
PRIMARY_SIGNAL_TEST_DATABASE_EXPECTED_ROLE=migration_test
PRIMARY_SIGNAL_TEST_PUBLICATION_DATABASE_URL=postgresql+psycopg://publication_writer_test:REPLACE_ME@database:5432/primary_signal_publication_test # pragma: allowlist secret
PRIMARY_SIGNAL_TEST_PUBLICATION_DATABASE_EXPECTED_ROLE=publication_writer_test
