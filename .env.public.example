# Placeholder configuration for the production public web process.
# Provision a login with only primary_signal_cap_public_read before use.
PRIMARY_SIGNAL_ENVIRONMENT=production
# Configure authentication through the deployment's secret store.
PRIMARY_SIGNAL_DATABASE_URL=postgresql+psycopg://public_reader@db.public.example/primarysignal
# For a file-backed secret, set PRIMARY_SIGNAL_DATABASE_URL_FILE to the mounted
# file path instead of PRIMARY_SIGNAL_DATABASE_URL. Never set both.
PRIMARY_SIGNAL_DATABASE_EXPECTED_ROLE=public_reader
