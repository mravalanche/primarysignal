# Copy to .env.publication.admin. Only the three restricted admin logins belong here.
# The certificate must cover localhost; browse through https://localhost:8443.
PRIMARY_SIGNAL_ENVIRONMENT=production
PRIMARY_SIGNAL_DEBUG=false
PRIMARY_SIGNAL_API_DOCS_ENABLED=false
PRIMARY_SIGNAL_DATABASE_URL=postgresql+psycopg://admin_session_test:REPLACE_ME@database:5432/primary_signal_publication_test # pragma: allowlist secret
PRIMARY_SIGNAL_DATABASE_EXPECTED_ROLE=admin_session_test
PRIMARY_SIGNAL_ADMIN_EDITORIAL_DATABASE_URL=postgresql+psycopg://editorial_reader_test:REPLACE_ME@database:5432/primary_signal_publication_test # pragma: allowlist secret
PRIMARY_SIGNAL_ADMIN_EDITORIAL_DATABASE_EXPECTED_ROLE=editorial_reader_test
PRIMARY_SIGNAL_ADMIN_PUBLICATION_DATABASE_URL=postgresql+psycopg://publication_decision_test:REPLACE_ME@database:5432/primary_signal_publication_test # pragma: allowlist secret
PRIMARY_SIGNAL_ADMIN_PUBLICATION_DATABASE_EXPECTED_ROLE=publication_decision_test
PRIMARY_SIGNAL_ADMIN_ORIGIN=https://localhost:8443
# Literal quoting preserves the dollar signs in an Argon2 PHC value.
PRIMARY_SIGNAL_ADMIN_PASSWORD_PHC='REPLACE_ME' # pragma: allowlist secret
PRIMARY_SIGNAL_ADMIN_SESSION_KEY_HEX=REPLACE_ME
